# Get a free key at https://console.groq.com/keys
# Leave blank to skip Groq entirely and run on Ollama only.
GROQ_API_KEY=

# Answering (chat). This is a tokens-per-minute decision, not a speed one: a
# chat call sends the whole retrieval context in one request, so the model's
# TPM ceiling must exceed QUERY_CONTEXT_TOKEN_BUDGET plus room for the answer.
# 8b-instant's 6,000 TPM cannot fit one query -- every call 429s and silently
# answers from the OpenRouter fallback instead. 70b-versatile gets 12,000.
GROQ_MODEL=llama-3.3-70b-versatile

# Graph building (entity/relationship + keyword extraction during ingest).
# Ingest speed is capped by tokens-per-minute, not model speed, so this wants
# the model with the LARGER free-tier budget: 70b-versatile gets 12,000 TPM,
# 8b-instant only 6,000.
GROQ_EXTRACT_MODEL=llama-3.3-70b-versatile

# Starting size of the extraction token budget. Groq's 429 body reports the
# real ceiling, so a wrong value self-corrects on the first 429 (and logs the
# value to put here). Raise on a paid tier.
GROQ_TPM_LIMIT=12000

# On a Groq 429, retry Groq itself this many extra times (beyond lightrag's
# built-in backoff) before falling back to OpenRouter/Ollama. Groq's
# per-model rate-limit window is ~60s, so waiting it out beats a CPU-bound
# Ollama call.
GROQ_RATE_LIMIT_RETRIES=2
GROQ_RATE_LIMIT_WAIT_SECONDS=20

# Answering fallback only, behind Groq (kept on a separate key/provider).
# Get a free key at https://openrouter.ai/keys and pick a model (free-tier
# slugs end in ":free") at https://openrouter.ai/models
# Leave blank to fall back straight to Ollama for answering instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Fallback used when GROQ_API_KEY/OPENROUTER_API_KEY are blank or a call fails.
# Requires `ollama serve` running locally.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Local, no key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Where the graph/kv files, the Qdrant store, the spreadsheet database and the
# inventory manifest live.
STORAGE_DIR=./storage

# Vector store. Vectors live in Qdrant with BOTH a dense (embedding) and a
# sparse (BM25 keyword) vector per point, fused with RRF at query time -- that
# is what makes an exact part number or column name findable, which cosine
# similarity alone is bad at.
#
# Blank QDRANT_URL runs Qdrant EMBEDDED out of STORAGE_DIR/qdrant: no server,
# no Docker, nothing to install. Point it at a real instance (e.g.
# http://localhost:6333) to scale out; nothing else in the app changes.
QDRANT_URL=
QDRANT_API_KEY=
# How deep each half of the hybrid search looks before fusion, as a multiple of
# top_k. Fusion can only rank what the branches returned.
HYBRID_PREFETCH_MULTIPLIER=4

# Article scraping via ZenRows (https://app.zenrows.com). Leave the key blank
# to fall back to trafilatura for every URL. js_render/premium_proxy cost extra
# credits, so they're off on the first attempt and only used on the retry when
# the first scrape comes back short or fails.
ZENROWS_API_KEY=
ZENROWS_TIMEOUT_SECONDS=25
ZENROWS_USE_JS_RENDER_DEFAULT=false
ZENROWS_USE_PREMIUM_PROXY_DEFAULT=false
# Cached .md scrapes with YAML frontmatter -- re-ingesting a URL is free.
SCRAPED_ARTICLES_DIR=./storage/scraped_articles

# Chunking, 10% overlap. 1024 halves the chunk count (and so the number of
# extraction LLM calls) versus the old 512.
CHUNK_TOKEN_SIZE=1024
CHUNK_OVERLAP_TOKEN_SIZE=100

# Graph extraction backend.
#   gliner = local encoder, one forward pass per ~150-word window. No API, no
#            rate limit, no daily quota. This is what makes a book ingestable.
#   llm    = the original per-chunk Groq/Ollama JSON extraction. Bound by
#            GROQ_TPM_LIMIT (~2 chunks/min), kept as a fallback for machines
#            that can't download the model.
EXTRACTION_BACKEND=gliner
GLINER_MODEL=urchade/gliner_small-v2.1
# Lower = more entities, more noise.
GLINER_THRESHOLD=0.4
GLINER_BATCH_SIZE=8
GLINER_USE_GPU=false
GLINER_MAX_ASYNC=2

# The ontology: the closed set of types every chunk is scored against. Editing
# this is how you retarget extraction at new content. Keep it short -- 8-10
# deliberate types is what keeps entity types consistent across a document.
ENTITY_LABELS=person,organization,location,product,technology,event,concept,date

# Entity extraction cost/speed tuning (LLM backend only). Gleaning re-runs extraction per chunk
# to catch missed entities -- doubles LLM calls/token cost per chunk, so it's
# off by default. Raise MAX_ASYNC_LLM for more parallel chunk extraction
# (bounded by your LLM provider's rate limits, not just token quota).
MAX_GLEANING=0
# A 1024-token chunk's JSON extraction call runs ~5,000 tokens against a 12,000
# TPM bucket, so 2 in flight is what fits. GROQ_TPM_LIMIT paces the rest.
MAX_ASYNC_LLM=2

# Hard cap on the context assembled per chat query (entities + relations +
# chunks + system prompt). LightRAG's own default is 30,000 tokens, which no
# free-tier Groq model can accept in one minute -- this is the single number
# that decides whether chat works on the primary model or silently falls back.
# Keep it comfortably under GROQ_TPM_LIMIT.
QUERY_CONTEXT_TOKEN_BUDGET=8000

# Cross-encoder re-ranking of retrieved chunks before the context is built.
# Local (sentence-transformers), no API key. The budget above decides how many
# chunks fit; this decides which ones -- so it matters more, not less, once the
# context is tight. cross-encoder/ms-marco-MiniLM-L-6-v2 is ~80MB; swap in
# BAAI/bge-reranker-v2-m3 for better multilingual quality at ~20x the size.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=10

CORS_ORIGINS=http://localhost:3000

# Spreadsheets. Rows live in DuckDB and every calculation is done there, never
# by the LLM -- which only writes a SELECT that is parsed and bound against the
# real schema before a row is read. SPREADSHEET_MAX_ROWS caps a result set.
SPREADSHEET_MAX_ROWS=500
# A workbook's structure (worksheets, columns, formula lineage) goes into the
# graph; its cells do not. The one exception is a categorical column's values,
# which link to entities the DOCUMENTS already named -- this caps how many
# distinct values are examined per column.
SPREADSHEET_MAX_GRAPH_VALUES=50

# Folder ingestion reads a path on the SERVER's own disk. Unset, any readable
# directory is fair game -- fine for the local single-user default, wrong the
# moment this API is bound to anything but localhost. Set it and folder
# ingestion is confined to that subtree.
FOLDER_INGEST_ROOT=
# Files above this are still tracked as nodes (name, size, type); only their
# contents are skipped.
FOLDER_MAX_FILE_MB=25

# Opik (Comet) LLM tracing -- https://www.comet.com/opik. Leave blank to
# disable tracing entirely. Workspace/project default to your account's
# default workspace and "noderels" if unset.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=noderels

# =====================================================================
# HOSTED / MULTI-USER DEPLOYMENT
# Everything below is inert on a local single-user install. The whole
# transformation from "localhost app" to "SaaS" is AUTH_DISABLED=false.
# =====================================================================

# false turns on authentication, per-user storage isolation, quotas, and
# refuses the server-path folder ingestion below. Leave it true for a local
# single-user install: that path keeps the existing storage layout untouched.
AUTH_DISABLED=true

# The identity every request runs as while AUTH_DISABLED=true. Its workspace is
# "" and its storage paths are the legacy flat ones, which is what makes
# turning multi-tenancy on a no-op for existing local data.
LOCAL_USER_ID=local

# Supabase project JWT secret: Project Settings -> API -> JWT Secret.
# Tokens are verified locally with it, so the API never calls Supabase on the
# request path and a sign-in outage cannot take retrieval down. This IS a
# secret -- it is the signing key. Never ship it to a browser or an extension.
SUPABASE_JWT_SECRET=

# Per-user storage ceiling, counted from the text actually indexed. 5 GB.
STORAGE_QUOTA_BYTES=5368709120

# Upload limits, enforced before anything is parsed.
MAX_FILE_SIZE_BYTES=209715200
MAX_BATCH_SIZE_BYTES=524288000
MAX_FILES_PER_BATCH=50

# How many users' LightRAG instances (and DuckDB connections) stay resident.
# Each holds a NetworkX graph and the KV stores in memory, so this is the
# memory knob: the least recently used is finalized when a new user arrives.
MAX_ACTIVE_WORKSPACES=8

# Per-user LLM limits, on top of the GLOBAL provider pacing GROQ_TPM_LIMIT
# already does. Without these one user ingesting a book spends the whole free
# tier's daily tokens and everyone else's chat silently drops to Ollama.
# A per-minute burst is waited out; the daily budget is refused.
LLM_LIMIT_USER_RPM=20
LLM_LIMIT_USER_CONCURRENT=2
LLM_LIMIT_USER_TOKENS_PER_DAY=200000

# Only used to attribute spend per user. Zero on a free tier, which is correct:
# the ledger still answers "who used the most tokens this month".
LLM_COST_PER_INPUT_TOKEN=0
LLM_COST_PER_OUTPUT_TOKEN=0
